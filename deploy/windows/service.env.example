# Copy this file to a protected location outside the application directory.
# Do not commit the resulting service.env file.

FLASHTERM_STAGE_PORT=8100
FLASHTERM_STAGE_DATA=D:\flashterm-stage\data
FLASHTERM_STAGE_TENANT=YOUR-TENANT-ID
FLASHTERM_STAGE_TERMBASE=

FLASHTERM_STAGE_AUTH=oidc
FLASHTERM_STAGE_PUBLIC_ORIGIN=https://stage.example.org
FLASHTERM_OIDC_ISSUER=https://identity.example.org/YOUR-TENANT
FLASHTERM_OIDC_CLIENT_ID=YOUR-CLIENT-ID
FLASHTERM_OIDC_CLIENT_SECRET=REPLACE_IN_PROTECTED_COPY
FLASHTERM_OIDC_GROUP_CLAIM=groups
FLASHTERM_STAGE_GROUP_ACCESS={"stage-readers":["YOUR-TERMBASE-ID"]}

FLASHTERM_PUBLISH_TOKEN=REPLACE_IN_PROTECTED_COPY
FLASHTERM_PUBLISH_TERMBASES=YOUR-TERMBASE-ID
